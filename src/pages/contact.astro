---
import Layout from '../layouts/Layout.astro';

const serviceOptions = [
  'Brand Identity Design',
  'Graphic Design',
  'Marketing Collaterals Design',
  'Packaging Design',
  'Portfolio Website Design',
  'E-Commerce Website Design',
  'Social Media Content Design',
  'Social Media Marketing',
  'Anything else',
];

const budgetOptions = ['1 Lac - 2 Lac', '2 Lac - 3 Lac', '3 Lac - 5 Lac', 'Above 5 Lac'];
const footerLinks = ['Expertise', 'Discover', 'Blog', 'Connect'];
const socialLinks = ['Behance', 'Instagram', 'Facebook', 'LinkedIn'];
const days = Array.from({ length: 31 }, (_, index) => index + 1);
---

<Layout title="Contact | PikZiy Studio">
  <main class="contact-page">
    <section class="contact-hero" aria-label="Contact hero">
      <div class="hero-portrait"></div>
      <div class="hero-copy">
        <h1>CONNECT</h1>
        <p>Bring your ideas to life<br />Let's start a conversation</p>
      </div>
    </section>

    <section class="contact-main" aria-label="Contact form and details">
      <form class="contact-form" data-wix-form="contact" aria-label="Contact form">
        <h2>Get In Touch</h2>

        <label>
          <span>What's your name? *</span>
          <input name="name" type="text" placeholder="Rishabh Khare (Your name)" required />
        </label>

        <div class="form-row">
          <label>
            <span>What's your email? *</span>
            <input name="email" type="email" placeholder="rishabh@google.com" required />
          </label>
          <label>
            <span>What's your phone number? *</span>
            <input name="phone" type="tel" placeholder="+91 9876543210" required />
          </label>
        </div>

        <label>
          <span>From *</span>
          <input name="company" type="text" placeholder="Google (company name)" required />
        </label>

        <fieldset>
          <legend>What kind of services are you looking for? *</legend>
          <div class="chip-grid">
            {serviceOptions.map((option) => (
              <label class="chip">
                <input type="checkbox" name="services" value={option} />
                <span>{option}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <label>
          <span>Please tell us a bit more about your project</span>
          <textarea name="project" rows="4"></textarea>
        </label>

        <fieldset>
          <legend>What is your budget range? *</legend>
          <div class="chip-grid budget-grid">
            {budgetOptions.map((option) => (
              <label class="chip">
                <input type="radio" name="budget" value={option} required />
                <span>{option}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <label>
          <span>How did you hear about us?</span>
          <select name="source">
            <option value="">Select</option>
            <option>Google Search</option>
            <option>Instagram</option>
            <option>Referral</option>
            <option>LinkedIn</option>
          </select>
        </label>

        <button class="submit-btn" type="submit">Submit</button>
      </form>

      <aside class="contact-cards" aria-label="Contact information">
        <article class="contact-card">
          <span class="card-icon" aria-hidden="true">⌂</span>
          <div>
            <p>Email</p>
            <a href="mailto:hello@pikziystudio.com">hello@pikziystudio.com</a>
            <a href="mailto:work@pikziystudio.com">work@pikziystudio.com</a>
          </div>
        </article>
        <article class="contact-card">
          <span class="card-icon" aria-hidden="true">☏</span>
          <div>
            <p>Phone</p>
            <a href="tel:+918999949439">+91 89999 49 439</a>
          </div>
        </article>
      </aside>
    </section>

    <footer class="contact-footer">
      <section class="team-cta" aria-label="Join the team">
        <div>
          <h2>Interested in working<br />together?</h2>
          <a href="mailto:hello@pikziystudio.com" class="team-btn">Join The Team</a>
        </div>
        <div class="team-faces" aria-hidden="true">👩🏻‍💻👩🏻‍🎨<br /><span>🧑🏻‍💼😮👨🏻‍💻</span></div>
      </section>

      <section class="footer-contact" aria-label="Quick contact details">
        <div>
          <h2>Have Questions?</h2>
          <a href="tel:+918999949439">+918999949439</a>
        </div>
        <div>
          <h2>Let's talk</h2>
          <a href="mailto:hello@pikziystudio.com">hello@pikziystudio.com</a>
        </div>
      </section>

      <section class="project-card" aria-label="Book a project call">
        <div class="project-copy">
          <h2>Ready to start a project?</h2>
          <p>We're excited to bring your vision to life. Whether you need a stunning website, a strong brand identity, or a comprehensive digital marketing strategy, our team is here to help.</p>
        </div>
        <div class="scheduler" aria-label="Select a date and time">
          <div class="scheduler-head">
            <h3>Select a Date and Time</h3>
            <span>India Standard Time (IST)</span>
          </div>
          <div class="calendar-row">
            <button type="button" aria-label="Previous month">‹</button>
            <strong>July&nbsp;&nbsp;2026</strong>
            <button type="button" aria-label="Next month">›</button>
          </div>
          <div class="calendar-area">
            <div class="calendar-grid" aria-hidden="true">
              {['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].map((day) => <span class="day-name">{day}</span>)}
              {days.map((day) => <span class:list={["date", { active: day === 4 }]}>{day}</span>)}
            </div>
            <div class="times">
              <p>Availability for Saturday, 4 July</p>
              <button type="button" class="selected">4:30 pm</button>
              <button type="button">5:00 pm</button>
              <button type="button">5:30 pm</button>
            </div>
          </div>
          <button class="next-btn" type="button">Next</button>
        </div>
      </section>

      <nav class="footer-nav" aria-label="Footer navigation">
        <div class="footer-link-group">
          {footerLinks.map((link) => <a href={link === 'Connect' ? '/contact' : '#'}>{link}</a>)}
        </div>
        <div class="footer-link-group">
          {socialLinks.map((link) => <a href="#">{link}</a>)}
        </div>
        <div class="footer-info">
          <strong>Contact Information</strong>
          <a href="mailto:hello@pikziystudio.com">hello@pikziystudio.com</a>
          <a href="mailto:work@pikziystudio.com">work@pikziystudio.com</a>
          <a href="tel:+918999949439">+91 89999 49 439</a>
        </div>
      </nav>

      <div class="footer-bottom">
        <p>© 2023 By PikZiy Studio.</p>
        <div>
          <a href="#">Terms & Conditions</a>
          <a href="#">Privacy Policy</a>
          <a href="#">Refund Policy</a>
        </div>
      </div>

      <p class="footer-wordmark" aria-hidden="true">PIKZIY STUDIO</p>
    </footer>
  </main>
</Layout>

<style>
  :global(body) {
    margin: 0;
    background: #fff;
    color: #050505;
    font-family: 'Unbounded', Arial, sans-serif;
  }

  .contact-page {
    overflow: hidden;
  }

  .contact-hero {
    position: relative;
    min-height: 590px;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: radial-gradient(circle at 51% 35%, #ffd643 0 15%, #f4a800 42%, #f8ab00 100%);
  }

  .hero-portrait {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(250, 172, 0, 0.7), rgba(250, 172, 0, 0.12) 45%, rgba(250, 172, 0, 0.72)),
      url('https://static.wixstatic.com/media/6dfab9_4daddee4cb874740a21db7a7eb729b98~mv2.jpg/v1/fill/w_1200,h_680,fp_0.55_0.35,q_85,enc_avif,quality_auto/6dfab9_4daddee4cb874740a21db7a7eb729b98~mv2.jpg') center / cover;
    mix-blend-mode: multiply;
    opacity: 0.85;
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    color: #fff;
    text-align: center;
    transform: translateY(54px);
  }

  .hero-copy h1 {
    margin: 0 0 28px;
    font-size: clamp(44px, 5vw, 76px);
    font-weight: 500;
    line-height: 0.95;
  }

  .hero-copy p {
    margin: 0;
    color: rgba(255, 255, 255, 0.78);
    font-family: Arial, sans-serif;
    font-size: clamp(18px, 1.7vw, 24px);
    line-height: 1.35;
  }

  .contact-main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(340px, 0.95fr);
    gap: clamp(36px, 5vw, 78px);
    padding: 76px clamp(30px, 5vw, 64px) 66px;
    background: #fff;
  }

  .contact-form h2 {
    margin: 0 0 32px;
    font-size: clamp(28px, 3vw, 40px);
  }

  .contact-form,
  .contact-form label,
  .contact-form fieldset {
    display: flex;
    flex-direction: column;
  }

  .contact-form {
    gap: 22px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .contact-form span,
  .contact-form legend {
    margin: 0 0 10px;
    font-family: Arial, sans-serif;
    font-size: 14px;
  }

  .contact-form input,
  .contact-form textarea,
  .contact-form select {
    width: 100%;
    border: 1px solid #111;
    border-radius: 6px;
    min-height: 34px;
    box-sizing: border-box;
    padding: 8px 12px;
    font-family: Arial, sans-serif;
    background: #fff;
  }

  .contact-form textarea {
    min-height: 78px;
    resize: vertical;
  }

  .contact-form fieldset {
    gap: 0;
    border: 0;
    padding: 0;
    margin: 0;
  }

  .chip-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .chip {
    display: inline-flex;
  }

  .chip input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .chip span {
    margin: 0;
    border: 1px solid #111;
    border-radius: 8px;
    padding: 9px 13px;
    font-size: 13px;
    cursor: pointer;
  }

  .chip input:checked + span {
    background: #111;
    color: #fff;
  }

  .submit-btn {
    align-self: flex-end;
    width: min(100%, 300px);
    border: 0;
    border-radius: 999px;
    padding: 14px 28px;
    background: #ffd400;
    color: #050505;
    font-family: Arial, sans-serif;
    cursor: pointer;
  }

  .contact-cards {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-top: 24px;
  }

  .contact-card {
    display: grid;
    grid-template-columns: 110px 1fr;
    align-items: center;
    min-height: 132px;
    border-radius: 16px;
    background: #e8f1f2;
    padding: 18px 34px;
  }

  .card-icon {
    display: grid;
    place-items: center;
    width: 92px;
    height: 92px;
    border-radius: 50%;
    background: #c4c4c4;
    font-family: Arial, sans-serif;
    font-size: 38px;
  }

  .contact-card p,
  .contact-card a {
    margin: 0;
    color: #6f777a;
    font-family: Arial, sans-serif;
    font-size: 18px;
    line-height: 1.4;
    text-decoration: none;
  }

  .contact-card p {
    margin-bottom: 8px;
  }

  .contact-footer {
    position: relative;
    background: #ff6900;
    color: #fff;
    padding-bottom: 170px;
  }

  .team-cta {
    background: #050505;
    padding: 76px clamp(30px, 5vw, 72px);
  }

  .team-cta > div:first-child,
  .team-cta {
    position: relative;
  }

  .team-cta {
    display: grid;
  }

  .team-cta::before {
    content: '';
    position: absolute;
    inset: 76px clamp(30px, 5vw, 72px);
    border-radius: 16px;
    background: linear-gradient(110deg, #ff6027, #ffd557 57%, #d93664);
    box-shadow: 0 0 30px rgba(255, 255, 255, 0.45);
  }

  .team-cta > div {
    position: relative;
    z-index: 1;
    min-height: 252px;
    padding: 54px 72px;
    box-sizing: border-box;
  }

  .team-cta h2 {
    margin: 0 0 32px;
    max-width: 420px;
    font-size: clamp(30px, 3vw, 44px);
    font-weight: 400;
    line-height: 1.25;
  }

  .team-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 190px;
    padding: 16px 24px;
    border-radius: 9px;
    background: #050505;
    color: #fff;
    font-family: Arial, sans-serif;
    text-decoration: none;
  }

  .team-faces {
    position: absolute;
    right: 11%;
    top: 94px;
    color: initial;
    font-size: clamp(68px, 8vw, 130px);
    line-height: 0.78;
    text-align: center;
  }

  .team-faces span {
    letter-spacing: -0.25em;
  }

  .footer-contact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 44px;
    padding: 34px clamp(30px, 5vw, 64px) 54px;
  }

  .footer-contact h2 {
    margin: 0 0 26px;
    font-size: clamp(38px, 4vw, 60px);
    font-weight: 400;
  }

  .footer-contact a {
    color: #111;
    font-family: Arial, sans-serif;
    font-size: clamp(24px, 2.3vw, 38px);
    text-decoration: none;
  }

  .project-card {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 46px;
    margin: 0 clamp(30px, 4vw, 44px) 66px;
    border-radius: 14px;
    background: #fff;
    color: #111;
    padding: 70px clamp(40px, 6vw, 70px);
  }

  .project-copy h2 {
    margin: 0 0 28px;
    font-size: clamp(32px, 3vw, 48px);
    font-weight: 400;
  }

  .project-copy p {
    max-width: 620px;
    margin: 0;
    font-family: Arial, sans-serif;
    font-size: 16px;
    line-height: 1.35;
  }

  .scheduler {
    font-family: Arial, sans-serif;
  }

  .scheduler-head,
  .calendar-row,
  .calendar-area {
    display: flex;
    align-items: center;
  }

  .scheduler-head {
    justify-content: space-between;
    border-bottom: 1px solid #d6d6d6;
    padding-bottom: 14px;
  }

  .scheduler-head h3 {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
  }

  .scheduler-head span {
    color: #777;
    font-size: 13px;
  }

  .calendar-row {
    justify-content: space-between;
    padding: 20px 0;
  }

  .calendar-row button {
    border: 0;
    background: transparent;
    font-size: 32px;
    cursor: pointer;
  }

  .calendar-area {
    align-items: flex-start;
    gap: 42px;
  }

  .calendar-grid {
    display: grid;
    grid-template-columns: repeat(7, 32px);
    gap: 14px 13px;
    text-align: center;
    color: #ee6238;
  }

  .day-name {
    color: #777;
  }

  .date {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
  }

  .date.active {
    background: #ee6238;
    color: #fff;
  }

  .times {
    min-width: 250px;
  }

  .times p {
    margin: 0 0 16px;
    font-size: 14px;
  }

  .times button {
    width: 100%;
    border: 1px solid #aaa;
    border-radius: 999px;
    margin-bottom: 14px;
    padding: 14px 18px;
    background: #fff;
    cursor: pointer;
  }

  .times .selected,
  .next-btn {
    border-color: #ee6238;
    background: #ee6238;
    color: #fff;
  }

  .next-btn {
    width: 100%;
    margin-top: 52px;
    border: 0;
    border-radius: 999px;
    padding: 14px;
    cursor: pointer;
  }

  .footer-nav,
  .footer-bottom {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 40px;
    padding: 0 clamp(30px, 5vw, 52px);
  }

  .footer-link-group {
    display: flex;
    gap: 32px;
    align-items: flex-start;
  }

  .footer-nav a,
  .footer-info,
  .footer-bottom,
  .footer-bottom a {
    color: #fff;
    font-family: Arial, sans-serif;
    font-size: 13px;
    line-height: 1.8;
    text-decoration: none;
  }

  .footer-info {
    display: flex;
    flex-direction: column;
    justify-self: end;
  }

  .footer-bottom {
    margin-top: 90px;
    align-items: end;
  }

  .footer-bottom p {
    margin: 0;
  }

  .footer-bottom div {
    grid-column: 3;
    display: flex;
    gap: 28px;
    justify-self: end;
  }

  .footer-wordmark {
    position: absolute;
    left: 28px;
    bottom: -110px;
    margin: 0;
    color: #fff;
    font-size: clamp(110px, 15vw, 250px);
    font-weight: 700;
    line-height: 0.75;
    letter-spacing: -0.08em;
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .contact-main,
    .project-card,
    .footer-contact,
    .footer-nav,
    .footer-bottom {
      grid-template-columns: 1fr;
    }

    .form-row {
      grid-template-columns: 1fr;
    }

    .contact-card {
      grid-template-columns: 88px 1fr;
      padding: 18px;
    }

    .card-icon {
      width: 68px;
      height: 68px;
      font-size: 28px;
    }

    .team-cta > div {
      padding: 40px 32px;
    }

    .team-faces {
      position: relative;
      right: auto;
      top: auto;
      margin-top: -90px;
      padding-left: 30%;
    }

    .calendar-area {
      flex-direction: column;
    }

    .footer-info,
    .footer-bottom div {
      justify-self: start;
      grid-column: auto;
    }
  }
</style>
