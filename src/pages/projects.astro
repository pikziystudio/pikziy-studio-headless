---
const projects = [
  {
    title: 'Brand Systems',
    category: 'Identity',
    description: 'Strategic visual systems built to make brands feel sharp, memorable, and easy to use.',
  },
  {
    title: 'Packaging Design',
    category: 'Product',
    description: 'Modern packaging concepts shaped around shelf impact, clarity, and tactile detail.',
  },
  {
    title: 'Digital Experiences',
    category: 'Web',
    description: 'Focused digital interfaces for studios, products, and service-led brands.',
  },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Projects | PikZiy Studio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main class="projects-page">
      <section class="hero">
        <a class="back-link" href="/">PikZiy Studio</a>
        <div>
          <p class="eyebrow">Selected Work</p>
          <h1>Projects</h1>
        </div>
      </section>

      <section class="project-grid" aria-label="Project categories">
        {projects.map((project) => (
          <article class="project-card">
            <p>{project.category}</p>
            <h2>{project.title}</h2>
            <span>{project.description}</span>
          </article>
        ))}
      </section>
    </main>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    background: #f5f1e8;
    color: #111;
    font-family: 'Unbounded', Arial, sans-serif;
  }

  .projects-page {
    min-height: 100vh;
    padding: 36px;
  }

  .hero {
    min-height: 52vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-bottom: 1px solid rgba(17, 17, 17, 0.22);
    padding-bottom: 32px;
  }

  .back-link {
    width: fit-content;
    color: inherit;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    text-transform: uppercase;
  }

  .eyebrow {
    margin: 0 0 16px;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(72px, 16vw, 210px);
    line-height: 0.9;
    text-transform: uppercase;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    padding-top: 28px;
  }

  .project-card {
    min-height: 260px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: 1px solid rgba(17, 17, 17, 0.22);
    border-radius: 8px;
    padding: 24px;
  }

  .project-card p,
  .project-card h2,
  .project-card span {
    margin: 0;
  }

  .project-card p {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
  }

  .project-card h2 {
    max-width: 9ch;
    font-size: clamp(28px, 4vw, 56px);
    line-height: 0.95;
    text-transform: uppercase;
  }

  .project-card span {
    max-width: 34ch;
    font-family: Arial, sans-serif;
    font-size: 16px;
    line-height: 1.45;
  }

  @media (max-width: 820px) {
    .projects-page {
      padding: 22px;
    }

    .hero {
      min-height: 44vh;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }

    .project-card {
      min-height: 220px;
    }
  }
</style>
