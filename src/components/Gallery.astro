---

<section class="gallery-section">
  <div class="gallery-grid">
    {projects.map((project) => (
      <a href={project.href || "/projects"} class="gallery-item" aria-label={"View " + project.title + " project"} style={"grid-column:" + project.col + "; grid-row:" + project.rowStart + " / span " + project.rowSpan + ";"}>
        <img src={project.image} alt={project.title} loading="lazy" />
      </a>
    ))}

    <div class="gallery-item view-more-cell" style="grid-column: 3; grid-row: 3 / span 1;">
      <a href="/projects" class="view-more-btn">
        VIEW MORE PROJECTS <span class="asterisk">*</span>
      </a>
    </div>
  </div>
</section>

<style>
  .gallery-section {
    background: #000;
    padding: 60px 40px;
    position: relative;
    z-index: 1;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    grid-auto-rows: 220px;
    gap: 16px;
  }

  .gallery-item {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 20px;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .gallery-item:hover img {
    transform: scale(1.05);
  }

  .view-more-cell {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .view-more-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #fff;
    color: #000;
    font-family: 'Unbounded', sans-serif;
    font-size: 15px;
    text-decoration: none;
    padding: 18px 32px;
    border-radius: 40px;
    transition: transform 0.3s ease;
  }

  .view-more-btn:hover {
    transform: scale(1.05);
  }

  .asterisk {
    color: #FF6A1A;
  }

  @media (max-width: 900px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .gallery-item {
      grid-column: auto !important;
      grid-row: span 1 !important;
    }
  }
</style>