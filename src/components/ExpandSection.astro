---
interface Props {
  image: string;
  heading: string;
  subtext?: string;
}

const { image, heading, subtext } = Astro.props;
---

<section class="expand-wrapper" id="expandWrapper">
  <div class="expand-sticky">
    <div class="expand-frame" id="expandFrame">
      <img class="expand-bg" src={image} alt="" />
      <div class="expand-content">
        <h2 class="expand-heading">{heading}</h2>
        {subtext && <p class="expand-subtext">{subtext}</p>}
      </div>
    </div>
  </div>
</section>

<style>
  .expand-wrapper {
    position: relative;
    height: 250vh; /* scroll runway that drives the expand */
    background: #000;
  }

.expand-sticky {
  position: sticky;
  top: 0;
  height: 100vh;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
  z-index: 10; /* add this — must be higher than any ServiceSection's z-index */
}

  .expand-frame {
    position: relative;
    width: 100%;
    height: 30vh; /* starting height */
    overflow: hidden;
    will-change: height;
  }

  .expand-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .expand-content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 80px;
    z-index: 1;
  }

  .expand-heading {
    font-family: 'Unbounded', sans-serif;
    font-weight: 300;
    font-size: clamp(36px, 5.5vw, 72px);
    color: #fff;
    line-height: 1.15;
    margin: 0 0 30px 0;
    max-width: 900px;
  }

  .expand-subtext {
    font-family: 'questrial', sans-serif;
    font-weight: 300;
    font-size: clamp(14px, 1.4vw, 18px);
    color: #000;
    line-height: 1.7;
    max-width: 500px;
    margin: 0;
  }
</style>

<script>
  const wrapper = document.getElementById('expandWrapper') as HTMLElement;
  const frame = document.getElementById('expandFrame') as HTMLElement;

  const MIN_HEIGHT = 30; // vh
  const MAX_HEIGHT = 100; // vh

  function updateExpand() {
    const rect = wrapper.getBoundingClientRect();
    const wrapperHeight = wrapper.offsetHeight;
    const viewportHeight = window.innerHeight;

    const scrolled = -rect.top;
    const totalScrollable = wrapperHeight - viewportHeight;
    let progress = scrolled / totalScrollable;
    progress = Math.min(Math.max(progress, 0), 1);

    const height = MIN_HEIGHT + (MAX_HEIGHT - MIN_HEIGHT) * progress;
    frame.style.height = `${height}vh`;
  }

  window.addEventListener('scroll', updateExpand, { passive: true });
  window.addEventListener('resize', updateExpand);
  updateExpand();
</script>