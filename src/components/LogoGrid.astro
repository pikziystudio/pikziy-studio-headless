  { name: "Intangles", src: "https://static.wixstatic.com/media/6dfab9_8a918ff4293b49f9a3db642167d885e4~mv2.png" },
  { name: "Heinz", src: "https://static.wixstatic.com/media/6dfab9_6c5ad464a6644cc7848bbf754d20295e~mv2.png" },
  { name: "Cadbury", src: "https://static.wixstatic.com/media/6dfab9_1eb03c02df934caf991c2acec4964934~mv2.png" },
  { name: "Bell Immersive Technologies", src: "https://static.wixstatic.com/media/6dfab9_8411cc7d65444159b7c6ff1702d13236~mv2.png" },
  { name: "TBG", src: "https://static.wixstatic.com/media/6dfab9_4393373bff694a6aa52ee36022abc65f~mv2.png" },
  { name: "Oreo", src: "https://static.wixstatic.com/media/6dfab9_e876f1e4cb844c06ae48389749604f94~mv2.png" },
  { name: "Nescafe", src: "https://static.wixstatic.com/media/6dfab9_b1e6d4136fc4476f80f03ae3b4975656~mv2.png" },
  { name: "HNS Developers", src: "https://static.wixstatic.com/media/6dfab9_4f1e8165f0f145f78ce81e1d9688f2d6~mv2.png" },
  { name: "Evian", src: "https://static.wixstatic.com/media/6dfab9_ac5213c87d37424a96d1e32e177b1e94~mv2.png" },
  { name: "Bell Energy", src: "https://static.wixstatic.com/media/6dfab9_436f2ad5cf78479ea9a6ad8607a9a86a~mv2.png" },
  { name: "Sorigin", src: "https://static.wixstatic.com/media/6dfab9_416147fbc49b494eb3131e90c4c34609~mv2.png" },
  { name: "OnePlus", src: "https://static.wixstatic.com/media/6dfab9_593b1db840f74cf196b43b1e6b447d7b~mv2.png" },
  { name: "Nestea", src: "https://static.wixstatic.com/media/6dfab9_e6441144d2334060a7334448ece7373b~mv2.png" },
  { name: "NXT", src: "https://static.wixstatic.com/media/6dfab9_291914a6d4d04b2aa4674ae2dea9a2f0~mv2.png" },
  { name: "Heineken", src: "https://static.wixstatic.com/media/6dfab9_7edda9e2aedd4742aa5cee86f869ded4~mv2.png" },
