---
interface Props {
  text: string;
}
const { text = "PURPOSEFUL CREATION" } = Astro.props;
---

<section class="marquee-section">
  <div class="marquee-track">
    <span class="marquee-group">
      {Array.from({ length: 6 }).map(() => (
        <>
          <span class="marquee-text">{text}</span>
          <span class="marquee-dot">@</span>
        </>
      ))}
    </span>
    <span class="marquee-group" aria-hidden="true">
      {Array.from({ length: 6 }).map(() => (
        <>
          <span class="marquee-text">{text}</span>
          <span class="marquee-dot">⊖</span>
        </>
      ))}
    </span>
  </div>
</section>

<style>
  .marquee-section {
    position: relative;
    background: #000;
    overflow: hidden;
    padding: 60px 0;
    z-index: 1; /* sits above the sticky hero as it scrolls up */
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: scroll 20s linear infinite;
  }

  .marquee-group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .marquee-text {
    font-family: 'Unbounded', sans-serif;
    font-weight: 500;
    font-size: clamp(32px, 5vw, 64px);
    color: #fff;
    white-space: nowrap;
    margin: 0 40px;
  }

  .marquee-dot {
    color: #FFC72C;
    font-size: clamp(28px, 4vw, 48px);
    flex-shrink: 0;
  }

  @keyframes scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
</style>