---
// src/components/Hero.astro
---

<section class="hero">
  <img
    class="hero-bg"
    src="https://static.wixstatic.com/media/6dfab9_4daddee4cb874740a21db7a7eb729b98~mv2.jpg/v1/fill/w_1600,h_772,fp_0.65_0.48,q_85,enc_avif,quality_auto/6dfab9_4daddee4cb874740a21db7a7eb729b98~mv2.jpg"
    alt="PikZiy Studio - Global Branding and Design Agency in Pune"
  />


  <h1 class="hero-title">PIKZIY STUDIO</h1>
</section>

<style>
.hero {
    position: sticky;
    top: 0;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    z-index: 0; /* sits behind content that scrolls over it */
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .hero-title {
    position: absolute;
    bottom: 20px;
    left: 20px;
    font-family: 'Unbounded', sans-serif;
    font-weight: 500;
    font-size: clamp(48px, 11vw, 240px);
    color: #FF6A1A;
    line-height: 0.9;
    z-index: 2;
    margin: 0;
  }

</style>