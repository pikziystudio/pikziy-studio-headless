---
// src/components/Header.astro

const menuItems = [
  { label: 'Home', href: '/' },
  { label: 'Projects', href: '/projects' },
];

const socialItems = [
  { label: 'Behance', href: '#', text: 'Be' },
  { label: 'Instagram', href: '#', text: '◎' },
  { label: 'Facebook', href: '#', text: 'f' },
  { label: 'X', href: '#', text: '𝕏' },
  { label: 'LinkedIn', href: '#', text: 'in' },
  { label: 'YouTube', href: '#', text: '▶' },
];
---

<header class="site-header" data-site-header>
  <a class="logo-wrap" href="/" aria-label="PikZiy Studio home">
    <!-- Outline layers (visible by default) -->
    <img class="logo-layer outline" src="https://static.wixstatic.com/media/6dfab9_b153c484133d4710a02465204b342ff5~mv2.png" alt="" style="--i:0" />
    <img class="logo-layer outline" src="https://static.wixstatic.com/media/6dfab9_62e909c46a9640e18522a23ae0e775f6~mv2.png" alt="" style="--i:1" />
    <img class="logo-layer outline" src="https://static.wixstatic.com/media/6dfab9_35995797998640e7ab619598fb27cb7a~mv2.png" alt="" style="--i:2" />
    <img class="logo-layer outline" src="https://static.wixstatic.com/media/6dfab9_95a45843d84046ef93c86408f49b6e35~mv2.png" alt="" style="--i:3" />

    <!-- Color-filled layers (hidden by default) -->
    <img class="logo-layer fill" src="https://static.wixstatic.com/media/6dfab9_70fc4ca050584995acef76e026a09478~mv2.png" alt="" style="--i:0" />
    <img class="logo-layer fill" src="https://static.wixstatic.com/media/6dfab9_869fa1895c0d4153aea85814d0ece0e4~mv2.png" alt="" style="--i:1" />
    <img class="logo-layer fill" src="https://static.wixstatic.com/media/6dfab9_8ff74665235b4bc498dc1f052232d486~mv2.png" alt="" style="--i:2" />
    <img class="logo-layer fill" src="https://static.wixstatic.com/media/6dfab9_e2dcccee6a494eeb8352bdbe7b8d57d7~mv2.png" alt="" style="--i:3" />
  </a>

  <button class="hamburger" type="button" aria-label="Open menu" aria-controls="site-menu" aria-expanded="false" data-menu-open>
    <span></span>
    <span></span>
  </button>
</header>

<div class="menu-layer" id="site-menu" aria-hidden="true" data-menu-layer>
  <img
    class="menu-bg"
    src="https://static.wixstatic.com/media/6dfab9_4daddee4cb874740a21db7a7eb729b98~mv2.jpg/v1/fill/w_1600,h_772,fp_0.65_0.48,q_85,enc_avif,quality_auto/6dfab9_4daddee4cb874740a21db7a7eb729b98~mv2.jpg"
    alt=""
  />
  <div class="menu-tint"></div>

  <a class="menu-logo" href="/" aria-label="PikZiy Studio home">
    <img class="logo-layer outline" src="https://static.wixstatic.com/media/6dfab9_b153c484133d4710a02465204b342ff5~mv2.png" alt="" style="--i:0" />
    <img class="logo-layer outline" src="https://static.wixstatic.com/media/6dfab9_62e909c46a9640e18522a23ae0e775f6~mv2.png" alt="" style="--i:1" />
    <img class="logo-layer outline" src="https://static.wixstatic.com/media/6dfab9_35995797998640e7ab619598fb27cb7a~mv2.png" alt="" style="--i:2" />
    <img class="logo-layer outline" src="https://static.wixstatic.com/media/6dfab9_95a45843d84046ef93c86408f49b6e35~mv2.png" alt="" style="--i:3" />
  </a>

  <button class="menu-close" type="button" aria-label="Close menu" data-menu-close>
    <span></span>
    <span></span>
  </button>

  <nav class="menu-nav" aria-label="Site pages">
    {menuItems.map((item) => (
      <a class="menu-link" href={item.href}>{item.label}</a>
    ))}
  </nav>

  <div class="social-bar" aria-label="Social media links">
    {socialItems.map((item) => (
      <a class="social-link" href={item.href} aria-label={item.label}>{item.text}</a>
    ))}
  </div>
</div>

<script>
  const header = document.querySelector('[data-site-header]');
  const openButton = document.querySelector('[data-menu-open]');
  const closeButton = document.querySelector('[data-menu-close]');
  const menuLayer = document.querySelector('[data-menu-layer]');
  const menuLinks = document.querySelectorAll('.menu-link');

  const updateHeader = () => {
    header?.classList.toggle('is-scrolled', window.scrollY > 0);
  };

  const setMenuOpen = (isOpen) => {
    menuLayer?.classList.toggle('is-open', isOpen);
    menuLayer?.setAttribute('aria-hidden', String(!isOpen));
    openButton?.setAttribute('aria-expanded', String(isOpen));
    document.body.classList.toggle('menu-open', isOpen);
  };

  updateHeader();
  window.addEventListener('scroll', updateHeader, { passive: true });
  openButton?.addEventListener('click', () => setMenuOpen(true));
  closeButton?.addEventListener('click', () => setMenuOpen(false));
  menuLinks.forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));
  window.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      setMenuOpen(false);
    }
  });
</script>

<style>
  :global(body.menu-open) {
    overflow: hidden;
  }

  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: 120px;
    background: transparent;
    transition: background-color 0.3s ease;
    pointer-events: none;
  }

  .site-header.is-scrolled {
    background: rgba(0, 0, 0, 0.5);
  }

  .logo-wrap,
  .hamburger {
    pointer-events: auto;
  }

  .logo-wrap,
  .menu-logo {
    position: absolute;
    width: 98px;
    height: 80px;
    cursor: pointer;
  }

  .logo-wrap {
    top: 50%;
    left: 30px;
    transform: translateY(-50%);
  }

  .logo-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: opacity 0.4s ease;
  }

  .logo-layer.outline {
    opacity: 1;
    transition-delay: calc(var(--i) * 0.1s);
  }

  .logo-layer.fill {
    opacity: 0;
    transition-delay: calc(var(--i) * 0s);
  }

  .logo-wrap:hover .logo-layer.outline {
    opacity: 0;
  }

  .logo-wrap:hover .logo-layer.fill {
    opacity: 1;
  }

  .hamburger {
    position: absolute;
    top: 50%;
    right: 40px;
    transform: translateY(-50%);
    width: 44px;
    height: 15px;
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 0;
  }

  .hamburger span {
    display: block;
    width: 100%;
    height: 2px;
    background: #fff;
    transition: transform 0.35s ease, width 0.35s ease;
  }

  .hamburger:hover span:nth-child(1) {
    transform: translateY(2px);
    width: 70%;
  }

  .hamburger:hover span:nth-child(2) {
    transform: translateY(-2px);
    width: 70%;
  }

  .menu-layer {
    position: fixed;
    inset: 0;
    z-index: 200;
    min-height: 100vh;
    padding: 120px clamp(28px, 5.6vw, 108px) 70px;
    box-sizing: border-box;
    color: #fff;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.35s ease, visibility 0.35s ease;
    overflow: hidden;
  }

  .menu-layer.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .menu-bg,
  .menu-tint {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .menu-bg {
    object-fit: cover;
    z-index: 0;
  }

  .menu-tint {
    z-index: 1;
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.88) 0%, rgba(1, 27, 29, 0.72) 45%, rgba(0, 165, 210, 0.68) 100%);
  }

  .menu-logo {
    top: 40px;
    left: 38px;
    z-index: 2;
  }

  .menu-close {
    position: absolute;
    top: 50px;
    right: 44px;
    z-index: 2;
    width: 42px;
    height: 42px;
    background: transparent;
    border: 0;
    cursor: pointer;
    padding: 0;
  }

  .menu-close span {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 2px;
    background: #fff;
  }

  .menu-close span:first-child {
    transform: rotate(45deg);
  }

  .menu-close span:last-child {
    transform: rotate(-45deg);
  }

  .menu-nav {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    min-height: calc(100vh - 260px);
    max-width: 760px;
  }

  .menu-link {
    display: block;
    width: min(100%, 680px);
    color: inherit;
    font-family: 'Unbounded', sans-serif;
    font-size: clamp(48px, 6vw, 92px);
    font-weight: 300;
    line-height: 1.12;
    letter-spacing: 0.025em;
    text-decoration: none;
    text-transform: uppercase;
    padding: 10px 0px 0px 0;
    transition: background-color 0.25s ease, color 0.25s ease, padding-left 0.25s ease;
  }

  .menu-link:hover,
  .menu-link:focus-visible {
    //background: #fff;
    color: #FF6A1A;
    padding-left: 0px;
    outline: none;
  }

  .social-bar {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 22px;
    margin-top: 22px;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 28px;
    height: 28px;
    color: #fff;
    font-family: Arial, sans-serif;
    font-size: 28px;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    transition: color 0.25s ease, transform 0.25s ease;
  }

  .social-link:hover,
  .social-link:focus-visible {
    color: #FF6A1A;
    transform: translateY(-3px);
    outline: none;
  }

  @media (max-width: 820px) {
    .site-header {
      height: 98px;
    }

    .logo-wrap,
    .menu-logo {
      width: 78px;
      height: 64px;
    }

    .logo-wrap {
      left: 22px;
    }

    .hamburger {
      right: 24px;
    }

    .menu-layer {
      padding: 110px 24px 42px;
    }

    .menu-logo {
      top: 28px;
      left: 22px;
    }

    .menu-close {
      top: 38px;
      right: 24px;
      width: 34px;
      height: 34px;
    }

    .menu-nav {
      min-height: calc(100vh - 250px);
    }

    .menu-link {
      font-size: clamp(42px, 13vw, 72px);
    }

    .social-bar {
      gap: 16px;
      flex-wrap: wrap;
    }
  }
</style>
