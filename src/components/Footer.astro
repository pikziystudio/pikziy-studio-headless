---
const footerLinks = ['Expertise', 'Discover', 'Blog', 'Connect'];
const socialLinks = ['Behance', 'Instagram', 'Facebook', 'LinkedIn'];
const days = Array.from({ length: 31 }, (_, index) => index + 1);
---

<footer class="site-footer">
  <section class="team-cta" aria-label="Join the team">
    <div>
      <h2>Interested in working<br />together?</h2>
      <a href="mailto:hello@pikziystudio.com" class="team-btn">Join The Team</a>
    </div>
    <div class="team-faces" aria-hidden="true">👩🏻‍💻👩🏻‍🎨<br /><span>🧑🏻‍💼😮👨🏻‍💻</span></div>
  </section>

  <section class="footer-contact" aria-label="Quick contact details">
    <div>
      <h2>Have Questions?</h2>
      <a href="tel:+918999949439">+918999949439</a>
    </div>
    <div>
      <h2>Let's talk</h2>
      <a href="mailto:hello@pikziystudio.com">hello@pikziystudio.com</a>
    </div>
  </section>

  <section class="project-card" aria-label="Book a project call">
    <div class="project-copy">
      <h2>Ready to start a project?</h2>
      <p>We're excited to bring your vision to life. Whether you need a stunning website, a strong brand identity, or a comprehensive digital marketing strategy, our team is here to help.</p>
    </div>
    <div class="scheduler" aria-label="Select a date and time">
      <div class="scheduler-head">
        <h3>Select a Date and Time</h3>
        <span>India Standard Time (IST)</span>
      </div>
      <div class="calendar-row">
        <button type="button" aria-label="Previous month">‹</button>
        <strong>July&nbsp;&nbsp;2026</strong>
        <button type="button" aria-label="Next month">›</button>
      </div>
      <div class="calendar-area">
        <div class="calendar-grid" aria-hidden="true">
          {['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].map((day) => <span class="day-name">{day}</span>)}
          {days.map((day) => <span class:list={["date", { active: day === 4 }]}>{day}</span>)}
        </div>
        <div class="times">
          <p>Availability for Saturday, 4 July</p>
          <button type="button" class="selected">4:30 pm</button>
          <button type="button">5:00 pm</button>
          <button type="button">5:30 pm</button>
        </div>
      </div>
      <button class="next-btn" type="button">Next</button>
    </div>
  </section>

  <nav class="footer-nav" aria-label="Footer navigation">
    <div class="footer-link-group">
      {footerLinks.map((link) => <a href={link === 'Connect' ? '/contact' : '#'}>{link}</a>)}
    </div>
    <div class="footer-link-group">
      {socialLinks.map((link) => <a href="#">{link}</a>)}
    </div>
    <div class="footer-info">
      <strong>Contact Information</strong>
      <a href="mailto:hello@pikziystudio.com">hello@pikziystudio.com</a>
      <a href="mailto:work@pikziystudio.com">work@pikziystudio.com</a>
      <a href="tel:+918999949439">+91 89999 49 439</a>
    </div>
  </nav>

  <div class="footer-bottom">
    <p>© 2023 By PikZiy Studio.</p>
    <div>
      <a href="#">Terms & Conditions</a>
      <a href="#">Privacy Policy</a>
      <a href="#">Refund Policy</a>
    </div>
  </div>

  <p class="footer-wordmark" aria-hidden="true">PIKZIY STUDIO</p>
</footer>

<style>
  .site-footer {
    position: relative;
    width: 100%;
    max-width: 100vw;
    overflow: hidden;
    box-sizing: border-box;
    background: #ff6900;
    color: #fff;
    padding-bottom: 170px;
  }

  .team-cta {
    position: relative;
    display: grid;
    background: #050505;
    padding: 76px clamp(30px, 5vw, 72px);
  }

  .team-cta::before {
    content: '';
    position: absolute;
    inset: 76px clamp(30px, 5vw, 72px);
    border-radius: 16px;
    background: linear-gradient(110deg, #ff6027, #ffd557 57%, #d93664);
    box-shadow: 0 0 30px rgba(255, 255, 255, 0.45);
  }

  .team-cta > div {
    position: relative;
    z-index: 1;
    min-height: 252px;
    padding: 54px 72px;
    box-sizing: border-box;
  }

  .team-cta h2 {
    margin: 0 0 32px;
    max-width: 420px;
    font-size: clamp(30px, 3vw, 44px);
    font-weight: 400;
    line-height: 1.25;
  }

  .team-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 190px;
    padding: 16px 24px;
    border-radius: 9px;
    background: #050505;
    color: #fff;
    font-family: Arial, sans-serif;
    text-decoration: none;
  }

  .team-faces {
    position: absolute;
    right: 11%;
    top: 94px;
    color: initial;
    font-size: clamp(68px, 8vw, 130px);
    line-height: 0.78;
    text-align: center;
  }

  .team-faces span {
    letter-spacing: -0.25em;
  }

  .footer-contact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 44px;
    padding: 34px clamp(30px, 5vw, 64px) 54px;
  }

  .footer-contact h2 {
    margin: 0 0 26px;
    font-size: clamp(38px, 4vw, 60px);
    font-weight: 400;
  }

  .footer-contact a {
    color: #111;
    font-family: Arial, sans-serif;
    font-size: clamp(24px, 2.3vw, 38px);
    text-decoration: none;
  }

  .project-card {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 46px;
    margin: 0 clamp(30px, 4vw, 44px) 66px;
    border-radius: 14px;
    background: #fff;
    color: #111;
    padding: 70px clamp(40px, 6vw, 70px);
  }

  .project-copy h2 {
    margin: 0 0 28px;
    font-size: clamp(32px, 3vw, 48px);
    font-weight: 400;
  }

  .project-copy p {
    max-width: 620px;
    margin: 0;
    font-family: Arial, sans-serif;
    font-size: 16px;
    line-height: 1.35;
  }

  .scheduler {
    font-family: Arial, sans-serif;
  }

  .scheduler-head,
  .calendar-row,
  .calendar-area {
    display: flex;
    align-items: center;
  }

  .scheduler-head {
    justify-content: space-between;
    border-bottom: 1px solid #d6d6d6;
    padding-bottom: 14px;
  }

  .scheduler-head h3 {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
  }

  .scheduler-head span {
    color: #777;
    font-size: 13px;
  }

  .calendar-row {
    justify-content: space-between;
    padding: 20px 0;
  }

  .calendar-row button {
    border: 0;
    background: transparent;
    font-size: 32px;
    cursor: pointer;
  }

  .calendar-area {
    align-items: flex-start;
    gap: 42px;
  }

  .calendar-grid {
    display: grid;
    grid-template-columns: repeat(7, 32px);
    gap: 14px 13px;
    text-align: center;
    color: #ee6238;
  }

  .day-name {
    color: #777;
  }

  .date {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
  }

  .date.active {
    background: #ee6238;
    color: #fff;
  }

  .times {
    min-width: 250px;
  }

  .times p {
    margin: 0 0 16px;
    font-size: 14px;
  }

  .times button {
    width: 100%;
    border: 1px solid #aaa;
    border-radius: 999px;
    margin-bottom: 14px;
    padding: 14px 18px;
    background: #fff;
    cursor: pointer;
  }

  .times .selected,
  .next-btn {
    border-color: #ee6238;
    background: #ee6238;
    color: #fff;
  }

  .next-btn {
    width: 100%;
    margin-top: 52px;
    border: 0;
    border-radius: 999px;
    padding: 14px;
    cursor: pointer;
  }

  .footer-nav,
  .footer-bottom {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 40px;
    padding: 0 clamp(30px, 5vw, 52px);
  }

  .footer-link-group {
    display: flex;
    gap: 32px;
    align-items: flex-start;
  }

  .footer-nav a,
  .footer-info,
  .footer-bottom,
  .footer-bottom a {
    color: #fff;
    font-family: Arial, sans-serif;
    font-size: 13px;
    line-height: 1.8;
    text-decoration: none;
  }

  .footer-info {
    display: flex;
    flex-direction: column;
    justify-self: end;
  }

  .footer-bottom {
    margin-top: 90px;
    align-items: end;
  }

  .footer-bottom p {
    margin: 0;
  }

  .footer-bottom div {
    grid-column: 3;
    display: flex;
    gap: 28px;
    justify-self: end;
  }

  .footer-wordmark {
    position: absolute;
    left: 28px;
    bottom: -110px;
    max-width: calc(100vw - 56px);
    margin: 0;
    color: #fff;
    font-size: clamp(110px, 15vw, 250px);
    font-weight: 700;
    line-height: 0.75;
    letter-spacing: -0.08em;
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .project-card,
    .footer-contact,
    .footer-nav,
    .footer-bottom {
      grid-template-columns: 1fr;
    }

    .team-cta > div {
      padding: 40px 32px;
    }

    .team-faces {
      position: relative;
      right: auto;
      top: auto;
      margin-top: -90px;
      padding-left: 30%;
    }

    .calendar-area {
      flex-direction: column;
    }

    .footer-info,
    .footer-bottom div {
      justify-self: start;
      grid-column: auto;
    }
  }
</style>
