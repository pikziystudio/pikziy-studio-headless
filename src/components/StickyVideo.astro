<section class="video-pin-wrapper">
  <div class="video-sticky">
    <div class="video-frame" id="videoFrame">
      <video
        id="scalingVideo"
        src="https://video.wixstatic.com/video/6dfab9_a5761912d15647a09db3df09be1141d0/360p/mp4/file.mp4"
        muted
        loop
        playsinline
        autoplay
      ></video>
    </div>
  </div>
</section>

<style>
  .video-pin-wrapper {
    position: relative;
    height: 250vh; /* scroll distance that drives the expand animation */
    background: #000;
    z-index: 1;
  }

  .video-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .video-frame {
    width: 30%; /* starting width */
    border-radius: 16px;
    overflow: hidden;
    will-change: width;
  }

  .video-frame video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>

<script>
  const wrapper = document.querySelector('.video-pin-wrapper') as HTMLElement;
  const frame = document.getElementById('videoFrame') as HTMLElement;

  const MIN_WIDTH = 30; // %
  const MAX_WIDTH = 70; // %

  function updateVideoWidth() {
    const rect = wrapper.getBoundingClientRect();
    const wrapperHeight = wrapper.offsetHeight;
    const viewportHeight = window.innerHeight;

    // scroll progress: 0 when wrapper top hits viewport top, 1 when wrapper bottom hits viewport bottom
    const scrolled = -rect.top;
    const totalScrollable = wrapperHeight - viewportHeight;
    let progress = scrolled / totalScrollable;
    progress = Math.min(Math.max(progress, 0), 1);

    const width = MIN_WIDTH + (MAX_WIDTH - MIN_WIDTH) * progress;
    frame.style.width = `${width}%`;
  }

  window.addEventListener('scroll', updateVideoWidth, { passive: true });
  window.addEventListener('resize', updateVideoWidth);
  updateVideoWidth();
</script>